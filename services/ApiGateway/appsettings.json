{
  "ReverseProxy": {
    "Routes": {
      "userRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/users"
          }
        ]
      },
      "doctorRoute": {
        "ClusterId": "doctorCluster",
        "Match": {
          "Path": "/doctors/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/doctors"
          }
        ]
      },
      "appointmentRoute": {
        "ClusterId": "appointmentCluster",
        "Match": {
          "Path": "/appointments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/appointments"
          }
        ]
      }
    },
    "Clusters": {
      "userCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5135/"
          }
        }
      },
      "doctorCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5056/"
          }
        }
      },
      "appointmentCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5006/"
          }
        }
      }
    }
  }
}